# Optional. Free key for the Open States API v3, used only for targeted refreshes between
# monthly bulk dumps. The bulk PostgreSQL dump and the per-state legislator CSVs are public
# and need no key, so the pipeline runs end to end without this.
# Request one at https://open.pluralpolicy.com/accounts/profile/
OPENSTATES_API_KEY=

# This project calls NO hosted LLM APIs. Models run locally on Apple Silicon (MPS).
# Do not add provider API keys here - src/state_politics/compute.py audits the source tree
# for hosted-provider imports and endpoints, and the test suite fails the build on any hit.
