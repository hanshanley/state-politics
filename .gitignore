# ---- Project data (never committed; fully reproducible from source) ----
# Use data/* rather than data/ so the .gitkeep negation below actually works:
# git cannot re-include a file whose parent directory is itself excluded.
data/*
!data/.gitkeep

# Large source corpora and dumps
*.pgdump
*.zip
*.pdf
*.parquet
*.sqlite
*.db

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ---- Virtual environments ----
.venv/
venv/
ENV/
env/

# ---- Tooling caches ----
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pytype/
.dmypy.json
dmypy.json
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/
.tox/
.nox/

# ---- Notebooks ----
.ipynb_checkpoints/

# ---- Secrets / local config ----
.env
.env.*
!.env.example
*.key
secrets.yml
secrets.yaml

# ---- OS / editor ----
.DS_Store
.AppleDouble
._*
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~
